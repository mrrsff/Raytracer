#version 460
#extension GL_EXT_scalar_block_layout : enable

#include "scene_layout.glsl"
#include "intersections.glsl"
#include "shading.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba8, binding = 0) uniform writeonly image2D outputImage;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y)
    return;

    float imageAspectRatio = float(size.x) / float(size.y);
    float u = (float(pixel.x) + 0.5) / float(size.x);
    float v = (float(pixel.y) + 0.5) / float(size.y);

    float tanFovY = tan(radians(camera.fovY) / 2.0);
    float Px = (2.0 * u - 1.0) * tanFovY * imageAspectRatio;
    float Py = (1.0 - 2.0 * v) * tanFovY;

    vec3 rayOrigin = camera.position;
    vec3 rayDirection = normalize(Px * camera.right + Py * camera.up + camera.forward);
    
    vec3 color = sceneGlobals.ambientLight;
    float closestT = 1e20;
    for (int i = 0; i < sceneGlobals.numSpheres; ++i)
    {
        float t = intersect_sphere(rayOrigin, rayDirection, spheres[i]);
        if (t > 0.0 && t < closestT)
        {
            closestT = t;
            vec3 hitPoint = rayOrigin + t * rayDirection;
            vec3 normal = normalize(hitPoint - spheres[i].center);
            // Simple shading
            color = shade(hitPoint, normal);
            
        }
    } 

    imageStore(outputImage, pixel, vec4(color, 1.0));
}