#version 460
#include "scene_layout.glsl"
#include "intersections.glsl"
#include "shading.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout (rgba8, binding = 0) uniform writeonly image2D outputImage;

vec3 TraceRay(Ray ray)
{
    vec3 finalColor = vec3(0.0);
    vec3 throughput = vec3(1.0);

    int maxBounces = 3; //sceneGlobals.maxBounces;
    for (int bounce = 0; bounce < maxBounces; ++bounce)
    {
        Intersection intersection = intersectScene(ray);
        if (intersection.t < INTERSECTION_TEST_EPSILON)
        {
            finalColor += throughput * sceneGlobals.backgroundColor;
            break;
        }
        
//        return (normalize(intersection.shadingNormal) * 0.5 + 0.5);

        vec3 shadedColor = shade(intersection);
        finalColor += throughput * shadedColor;
        break;
    }

    return finalColor;
}

vec3 TonemapReinhard(vec3 c)
{
    return c / (1.0 + c);
}
vec3 TonemapACES(vec3 x)
{
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x*(a*x+b)) / (x*(c*x+d)+e), 0.0, 1.0);
}
void main()
{    
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y)
    return;

    Ray ray = generateCameraRay(pixel.x, pixel.y, size.x, size.y, camera);
    vec3 color = TraceRay(ray);
    color = clamp(color, 0, 255.0) / 255.0;
    
    imageStore(outputImage, pixel, vec4(color, 1.0));
}