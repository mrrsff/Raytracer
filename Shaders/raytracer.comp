bool IntersectSphere(Ray ray, vec3 center, float radius, out float tHit)
{
    vec3 oc = ray.origin - center;
    float a = dot(ray.direction, ray.direction);
    float b = 2.0 * dot(oc, ray.direction);
    float c = dot(oc, oc) - radius * radius;

    float disc = b * b - 4.0 * a * c;
    if (disc < 0.0)
    return false;

    float sqrtDisc = sqrt(disc);
    float t0 = (-b - sqrtDisc) / (2.0 * a);
    float t1 = (-b + sqrtDisc) / (2.0 * a);

    tHit = (t0 > 0.0) ? t0 : t1;
    return tHit > 0.0;
}
vec3 TraceRay(Ray ray)
{
    // test sphere: centered at z = -3, radius 1
    vec3 sphereCenter = vec3(0.0, 0.0, -10.0);
    float sphereRadius = 1.0;

    float t;
    if (IntersectSphere(ray, sphereCenter, sphereRadius, t))
    {
        vec3 hitPos = ray.origin + t * ray.direction;
        vec3 N = normalize(hitPos - sphereCenter);
        return N * 0.5 + 0.5;
    }

    return vec3(0.1); 
}

void main()
{    
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y)
    return;

    Ray ray = generateCameraRay(pixel.x, pixel.y, size.x, size.y, camera);
    vec3 color = TraceRay(ray);

    imageStore(outputImage, pixel, vec4(color, 1.0));
}